# Base URL the browser uses for API calls.
# Leave empty (default) to use same-origin relative paths that the Next.js
# rewrite proxies to the backend. Set an absolute origin only if you want the
# browser to talk to the backend directly (skips the proxy).
NEXT_PUBLIC_API_URL=

# Backend origin the Next.js rewrite forwards /api/* requests to (server-side).
# Optional; defaults to http://127.0.0.1:8000 when unset.
BACKEND_ORIGIN=http://127.0.0.1:8000
